@@ -406,6 +406,26 @@ spv::Id build_descriptor_qa_check_function(SPIRVModule &module)
 	                                   cookie_shifted_id, cookie_mask_id,
 	                                   descriptor_timestamp_id, descriptor_info_id);
 
+	// miles-bench: count accesses per resource. live_status_table[DESCRIPTOR_QA_COUNT_BASE + (cookie & mask)]
+	// is a per-cookie access counter (vkd3d sizes the table to match, see vkd3d_descriptor_debug.h).
+	{
+		spv::Id u32_type = builder.makeUintType(32);
+		spv::Id slot_id = build_binary_op(builder, u32_type, spv::OpBitwiseAnd, cookie_id,
+		                                  builder.makeUintConstant(DESCRIPTOR_QA_COUNT_SLOTS - 1));
+		spv::Id index_id = build_binary_op(builder, u32_type, spv::OpIAdd, slot_id,
+		                                   builder.makeUintConstant(DESCRIPTOR_QA_COUNT_BASE));
+		spv::Id ptr_type = builder.makePointer(spv::StorageClassStorageBuffer, u32_type);
+		auto *chain = builder.addInstruction(ptr_type, spv::OpAccessChain);
+		chain->addIdOperand(global_buffer_id);
+		chain->addIdOperand(builder.makeUintConstant(uint32_t(DescriptorQAGlobalMembers::LiveStatusTable)));
+		chain->addIdOperand(index_id);
+		auto *add = builder.addInstruction(u32_type, spv::OpAtomicIAdd);
+		add->addIdOperand(chain->getResultId());
+		add->addIdOperand(builder.getAtomicDeviceScopeId());
+		add->addIdOperand(builder.makeUintConstant(0));
+		add->addIdOperand(builder.makeUintConstant(1));
+	}
+
 	spv::Id live_status_id = build_ssbo_load_array(builder, builder.makeUintType(32),
 	                                               global_buffer_id,
