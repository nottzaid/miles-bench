From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zaid <nottzaid@tutamail.com>
Date: Thu, 15 Oct 2026 07:01:25 +0300
Subject: [PATCH 03/12] miles-bench S14: index cache eviction frees whole runs

idxc_alloc_locked compared run_of[i] against the run being evicted while
clearing it, so only part of each evicted run was freed: the rest stayed
attached to the old run's first page, counted as used, and the cache
refused runs it had room for (2153 -> 304 refusals/s in the fight). It
never served wrong data (verify run: 636,136 hits, 0 mismatches).

Also exports the cache's pages by age and its requests/failures by run
size to the frame trace (IA / IS lines).
---
 libs/vkd3d/enginepatch.c   | 19 ++++++++
 libs/vkd3d/idxcache.c      | 93 +++++++++++++++++++++++++++++++++++---
 libs/vkd3d/vkd3d_private.h |  4 ++
 3 files changed, 110 insertions(+), 6 deletions(-)

diff --git a/libs/vkd3d/enginepatch.c b/libs/vkd3d/enginepatch.c
index 626d8b1f..e59c87ca 100644
--- a/libs/vkd3d/enginepatch.c
+++ b/libs/vkd3d/enginepatch.c
@@ -2184,6 +2184,25 @@ void vkd3d_frametrace_present(void)
                         "\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\n", (now - frametrace_t0) / 1e6, hits, misses, full, bytes >> 10,
                         used, stale, invalidations, verified, mismatched, scan_steps);
         }
+        {
+            uint32_t age[7];
+
+            /* IA t MiB of the index cache held by runs last drawn 0, 1, 2, 3, 4-7, 8+ presents
+             * ago, MiB free */
+            uint64_t req[7], fail[7];
+            uint32_t gap;
+
+            /* IS t requests then failures for runs of 1, 2, 3-4, 5-8, 9-16, 17-64, 65+ pages, largest
+             * evictable gap (pages) seen by a failed search */
+            if (vkd3d_index_cache_size_stats(req, fail, &gap))
+                fprintf(frametrace_file, "IS\t%.3f\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%"PRIu64
+                        "\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%"PRIu64"\t%u\n",
+                        (now - frametrace_t0) / 1e6, req[0], req[1], req[2], req[3], req[4], req[5], req[6],
+                        fail[0], fail[1], fail[2], fail[3], fail[4], fail[5], fail[6], gap);
+            if (vkd3d_index_cache_age_stats(age))
+                fprintf(frametrace_file, "IA\t%.3f\t%u\t%u\t%u\t%u\t%u\t%u\t%u\n", (now - frametrace_t0) / 1e6,
+                        age[0], age[1], age[2], age[3], age[4], age[5], age[6]);
+        }
         if (vkd3d_geomirror_active())
         {
             uint64_t bytes, runs, syncs, waits, scan_ns;
diff --git a/libs/vkd3d/idxcache.c b/libs/vkd3d/idxcache.c
index 6f7978d9..ce0be027 100644
--- a/libs/vkd3d/idxcache.c
+++ b/libs/vkd3d/idxcache.c
@@ -87,8 +87,17 @@ static struct
     uint64_t fail_frame;
     uint32_t fail_pages;
     uint64_t scan_steps;
+    /* Allocation requests and failures by run size (pages: 1, 2, 3-4, 5-8, 9-16, 17-64, 65+), and the
+     * largest free-or-evictable gap seen by a failed search (pages). Measurement only. */
+    uint64_t req_size[7], fail_size[7];
+    uint32_t fail_gap;
 } idxc;
 
+static unsigned int idxc_size_class(uint32_t pages)
+{
+    return pages <= 1 ? 0 : pages <= 2 ? 1 : pages <= 4 ? 2 : pages <= 8 ? 3 : pages <= 16 ? 4 : pages <= 64 ? 5 : 6;
+}
+
 static uint64_t idxc_frame;
 
 void vkd3d_index_cache_present(void)
@@ -273,10 +282,14 @@ static int32_t idxc_alloc_locked(uint32_t pages)
     uint32_t scanned = 0, head, i;
     int32_t run;
 
+    idxc.req_size[idxc_size_class(pages)]++;
     if (pages > idxc.cache_pages)
         return -1;
     if (idxc_failfast && idxc.fail_frame == frame + 1 && pages >= idxc.fail_pages)
+    {
+        idxc.fail_size[idxc_size_class(pages)]++;
         return -1;
+    }
     while (scanned < 2 * idxc.cache_pages)
     {
         idxc.scan_steps++;
@@ -300,15 +313,20 @@ static int32_t idxc_alloc_locked(uint32_t pages)
             idxc.cache_head = i;
             continue;
         }
-        /* Evict every run overlapping [head, head + pages), including ones starting earlier. */
+        /* Evict every run overlapping [head, head + pages), including ones starting earlier: all
+         * of its pages, from its first. (Comparing against run_of[i] while clearing freed only the
+         * pages up to i: the rest stayed tied to the run's first page and, once a new run started
+         * there, counted as part of it, so freed space looked drawn and the ring refused draws.) */
         for (i = head; i < head + pages; i++)
         {
-            if ((run = idxc.run_of[i]) < 0)
+            int32_t victim;
+
+            if ((victim = idxc.run_of[i]) < 0)
                 continue;
-            if (idxc.table[idxc.run_owner[run]].slot == (uint32_t)run + 1)
-                idxc.table[idxc.run_owner[run]].slot = 0;
-            while ((uint32_t)run < idxc.cache_pages && idxc.run_of[run] == idxc.run_of[i])
-                idxc.run_of[run++] = -1;
+            if (idxc.table[idxc.run_owner[victim]].slot == (uint32_t)victim + 1)
+                idxc.table[idxc.run_owner[victim]].slot = 0;
+            for (run = victim; (uint32_t)run < idxc.cache_pages && idxc.run_of[run] == victim; run++)
+                idxc.run_of[run] = -1;
         }
         for (i = head; i < head + pages; i++)
             idxc.run_of[i] = head;
@@ -316,6 +334,20 @@ static int32_t idxc_alloc_locked(uint32_t pages)
         idxc.cache_head = head + pages;
         return head;
     }
+    idxc.fail_size[idxc_size_class(pages)]++;
+    {
+        uint32_t gap = 0, best = 0;
+
+        for (i = 0; i < idxc.cache_pages; i++)
+        {
+            run = idxc.run_of[i];
+            if (run >= 0 && idxc.run_last[run] + IDXC_REUSE_FRAMES > frame)
+                gap = 0;
+            else if (++gap > best)
+                best = gap;
+        }
+        idxc.fail_gap = max(idxc.fail_gap, best);
+    }
     /* Stored as frame + 1 so that 0 (zero-initialized) never matches present 0. */
     if (idxc.fail_frame != frame + 1 || pages < idxc.fail_pages)
     {
@@ -438,6 +470,55 @@ void vkd3d_index_cache_flush(struct d3d12_device *device)
     pthread_mutex_unlock(&idxc_lock);
 }
 
+bool vkd3d_index_cache_size_stats(uint64_t req[7], uint64_t fail[7], uint32_t *gap)
+{
+    unsigned int i;
+
+    if (!idxc.cache_ok)
+        return false;
+    pthread_mutex_lock(&idxc_lock);
+    for (i = 0; i < 7; i++)
+    {
+        req[i] = idxc.req_size[i];
+        fail[i] = idxc.fail_size[i];
+        idxc.req_size[i] = idxc.fail_size[i] = 0;
+    }
+    *gap = idxc.fail_gap;
+    idxc.fail_gap = 0;
+    pthread_mutex_unlock(&idxc_lock);
+    return true;
+}
+
+bool vkd3d_index_cache_age_stats(uint32_t mib[7])
+{
+    uint64_t frame, pages[7] = {0}, age;
+    uint32_t i, end, b;
+    int32_t run;
+
+    if (!idxc.cache_ok)
+        return false;
+    pthread_mutex_lock(&idxc_lock);
+    frame = __atomic_load_n(&idxc_frame, __ATOMIC_RELAXED);
+    for (i = 0; i < idxc.cache_pages; i = end)
+    {
+        end = i + 1;
+        if ((run = idxc.run_of[i]) < 0)
+        {
+            pages[6]++;
+            continue;
+        }
+        while (end < idxc.cache_pages && idxc.run_of[end] == run)
+            end++;
+        age = frame >= idxc.run_last[run] ? frame - idxc.run_last[run] : 0;
+        b = age < 4 ? (uint32_t)age : (age < 8 ? 4 : 5);
+        pages[b] += end - i;
+    }
+    pthread_mutex_unlock(&idxc_lock);
+    for (b = 0; b < 7; b++)
+        mib[b] = (uint32_t)((pages[b] << idxc_page_shift) >> 20);
+    return true;
+}
+
 bool vkd3d_index_cache_take_stats(uint64_t *hits, uint64_t *misses, uint64_t *full, uint64_t *bytes,
         uint32_t *used_mib, uint64_t *stale, uint64_t *invalidations, uint64_t *verified, uint64_t *mismatched,
         uint64_t *scan_steps)
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 50146af6..210fcf15 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -1051,6 +1051,10 @@ bool vkd3d_index_cache_lookup(VkBuffer buffer, VkDeviceSize offset, VkDeviceSize
         VkBuffer *out_buffer, VkDeviceSize *out_offset);
 void vkd3d_index_cache_flush(struct d3d12_device *device);
 void vkd3d_index_cache_present(void);
+/* Cache pages held by runs last drawn 0, 1, 2, 3, 4-7 and 8+ presents ago, then free pages (MiB). */
+bool vkd3d_index_cache_age_stats(uint32_t mib[7]);
+/* Allocation requests and failures per run size class since the last call, largest gap at a failure. */
+bool vkd3d_index_cache_size_stats(uint64_t req[7], uint64_t fail[7], uint32_t *gap);
 bool vkd3d_index_cache_take_stats(uint64_t *hits, uint64_t *misses, uint64_t *full, uint64_t *bytes,
         uint32_t *used_mib, uint64_t *stale, uint64_t *invalidations, uint64_t *verified, uint64_t *mismatched,
         uint64_t *scan_steps);
