diff --git a/libs/vkd3d/idxcache.c b/libs/vkd3d/idxcache.c
new file mode 100644
index 00000000..331ee0a3
--- /dev/null
+++ b/libs/vkd3d/idxcache.c
@@ -0,0 +1,448 @@
+/*
+ * Index cache (miles-bench, VKD3D_BENCH_INDEX_CACHE=1).
+ *
+ * Miles Morales keeps all geometry in one 800 MiB CUSTOM write-combined L0 heap ("ManagedBuffer",
+ * D3DBufferManager::InitBuffer 0x1d6e0e0), so ~70k indexed draws a second read ~515 MB/s of
+ * indices across PCIe, while the distinct 64 KiB pages they touch add up to only ~30 MiB a second.
+ * This keeps a VRAM copy of the index ranges draws use: the first draw that needs a run of source
+ * pages gets the run copied into a VRAM buffer, and every draw over it binds the copy instead
+ * (firstIndex rebased; shaders cannot observe firstIndex). Same index bytes, read locally.
+ *
+ * Copies are queued while the draw is recorded and go out on the memory transfer queue at the
+ * start of the next ExecuteCommandLists. Each flush makes every queue wait for it
+ * (vkd3d_add_wait_to_all_queues), and a list can only be submitted after it was recorded, so the
+ * copy always lands before the draw reads it. The source is read at flush time, after the CPU has
+ * written the geometry the draw was recorded for.
+ *
+ * The cache is a ring of 64 KiB pages with clock-style reuse: a new run takes the next pages whose
+ * runs were not drawn in the last IDXC_REUSE_FRAMES presents (the game keeps at most a few frames in
+ * flight), and runs still in use are skipped over, so the hot set stays resident.
+ *
+ * Invalidation: the engine writes geometry into the heap only through D3DBufferManager
+ * (enginepatch.c hooks every writer and reports each written range after the write, plus every new
+ * allocation). Each write stamps its source pages with a new generation; a cached run carries the
+ * generation it was copied at and serves a draw only if none of the draw's pages were written
+ * since. A GPU write into the heap (never seen: the ManagedBuffer is filled by CPU stores) turns the
+ * cache off for good.
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+
+#include "vkd3d_private.h"
+
+/* Page size and cache size: VKD3D_BENCH_INDEX_CACHE_PAGE_SHIFT (default 12 = 4 KiB; a draw's
+ * indices are a few KiB, so 64 KiB pages made ~1600 draws a frame need ~100 MiB of cache and it
+ * thrashed) and VKD3D_BENCH_INDEX_CACHE_MB (default 64). */
+static unsigned int idxc_page_shift = 12;
+static VkDeviceSize idxc_size = 64ull << 20;
+#define IDXC_MIN_SOURCE (256ull << 20)
+#define IDXC_REUSE_FRAMES 8
+
+struct idxc_entry
+{
+    uint16_t pages;
+    uint32_t slot; /* first cache page + 1, 0 = none */
+};
+
+struct idxc_copy
+{
+    VkDeviceSize src, dst, size;
+};
+
+static pthread_mutex_t idxc_lock = PTHREAD_MUTEX_INITIALIZER;
+static int idxc_enabled = -1;
+/* VKD3D_BENCH_INDEX_CACHE_VERIFY=1: the cache lives in CPU-readable memory and every 16th hit on a
+ * run copied at least 4 presents ago is compared byte for byte with the source. A mismatch means a
+ * geometry write the hooks did not report. Slow; for proving the cache lossless, not for play. */
+static bool idxc_verify;
+/* VKD3D_BENCH_INDEX_CACHE_FAILFAST=0 restores the full ring walk on every failed allocation (A/B). */
+static bool idxc_failfast = true;
+
+static struct
+{
+    struct d3d12_heap *heap;
+    VkBuffer src_buffer;
+    VkDeviceSize src_offset, src_size;
+    struct vkd3d_memory_allocation cache;
+    bool cache_ok;
+    uint32_t cache_pages, cache_head;
+    /* Per cache page: first page of the run covering it (-1 = free); at a run's first page also
+     * the source page that owns it and the present count it was last drawn in. */
+    int32_t *run_of;
+    uint32_t *run_owner;
+    uint64_t *run_last;
+    struct idxc_entry *table;
+    uint32_t *page_gen;  /* per source page: generation of the last write */
+    uint32_t *run_gen;   /* per cache page, at a run's first page: generation it was copied at */
+    uint32_t gen;
+    const uint8_t *src_cpu;
+    bool disabled;
+    struct idxc_copy *pending;
+    size_t pending_count, pending_size;
+    uint64_t hits, misses, full, bytes, stale, invalidations, verified, mismatched;
+    uint64_t *run_copied; /* per cache page, at a run's first page: present count of the copy */
+    /* The present count of the last failed allocation and the smallest run size that failed in it:
+     * within one present nothing becomes evictable (run_last only grows), so any run at least that
+     * big fails again; it is refused without rescanning the ring. */
+    uint64_t fail_frame;
+    uint32_t fail_pages;
+    uint64_t scan_steps;
+} idxc;
+
+static uint64_t idxc_frame;
+
+void vkd3d_index_cache_present(void)
+{
+    __atomic_add_fetch(&idxc_frame, 1, __ATOMIC_RELAXED);
+}
+
+/* Presents so far (any swapchain), for bench probes that report per-frame rates. */
+uint64_t vkd3d_bench_present_count(void)
+{
+    return __atomic_load_n(&idxc_frame, __ATOMIC_RELAXED);
+}
+
+bool vkd3d_index_cache_wanted(const D3D12_HEAP_DESC *desc)
+{
+    char env[8];
+
+    if (idxc_enabled < 0)
+    {
+        idxc_enabled = vkd3d_get_env_var("VKD3D_BENCH_INDEX_CACHE", env, sizeof(env)) && env[0] == '1';
+        idxc_verify = vkd3d_get_env_var("VKD3D_BENCH_INDEX_CACHE_VERIFY", env, sizeof(env)) && env[0] == '1';
+        idxc_failfast = !(vkd3d_get_env_var("VKD3D_BENCH_INDEX_CACHE_FAILFAST", env, sizeof(env)) && env[0] == '0');
+        if (vkd3d_get_env_var("VKD3D_BENCH_INDEX_CACHE_PAGE_SHIFT", env, sizeof(env)) && atoi(env) >= 8 && atoi(env) <= 20)
+            idxc_page_shift = atoi(env);
+        if (vkd3d_get_env_var("VKD3D_BENCH_INDEX_CACHE_MB", env, sizeof(env)) && atoi(env) > 0)
+            idxc_size = (VkDeviceSize)atoi(env) << 20;
+    }
+    return idxc_enabled && !idxc.src_buffer &&
+            desc->Properties.Type == D3D12_HEAP_TYPE_CUSTOM &&
+            desc->Properties.CPUPageProperty == D3D12_CPU_PAGE_PROPERTY_WRITE_COMBINE &&
+            desc->Properties.MemoryPoolPreference == D3D12_MEMORY_POOL_L0 &&
+            (desc->Flags & D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS) == D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS &&
+            desc->SizeInBytes >= IDXC_MIN_SOURCE;
+}
+
+/* Right after the geometry heap got its memory: allocate the VRAM cache now, at startup, so it
+ * gets VRAM before the streamed textures fill the budget. */
+void vkd3d_index_cache_register(struct d3d12_device *device, struct d3d12_heap *heap)
+{
+    struct vkd3d_allocate_heap_memory_info alloc_info;
+    size_t src_pages;
+
+    pthread_mutex_lock(&idxc_lock);
+    if (!idxc.cache_ok)
+    {
+        memset(&alloc_info, 0, sizeof(alloc_info));
+        alloc_info.heap_desc.Properties.Type = D3D12_HEAP_TYPE_DEFAULT;
+        if (idxc_verify)
+        {
+            /* CPU-readable (cached system memory) but still usable as an index buffer. */
+            alloc_info.heap_desc.Properties.Type = D3D12_HEAP_TYPE_CUSTOM;
+            alloc_info.heap_desc.Properties.CPUPageProperty = D3D12_CPU_PAGE_PROPERTY_WRITE_BACK;
+            alloc_info.heap_desc.Properties.MemoryPoolPreference = D3D12_MEMORY_POOL_L0;
+        }
+        alloc_info.heap_desc.SizeInBytes = idxc_size;
+        alloc_info.heap_desc.Alignment = D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT;
+        alloc_info.heap_desc.Flags = D3D12_HEAP_FLAG_ALLOW_ONLY_BUFFERS | D3D12_HEAP_FLAG_CREATE_NOT_ZEROED;
+        alloc_info.extra_allocation_flags = VKD3D_ALLOCATION_FLAG_INTERNAL_SCRATCH;
+        alloc_info.vk_memory_priority = vkd3d_convert_to_vk_prio(D3D12_RESIDENCY_PRIORITY_HIGH);
+        if (FAILED(vkd3d_allocate_heap_memory(device, &device->memory_allocator, &alloc_info, &idxc.cache)))
+        {
+            ERR("idxcache: failed to allocate the %"PRIu64" MiB cache.\n", (uint64_t)(idxc_size >> 20));
+            pthread_mutex_unlock(&idxc_lock);
+            return;
+        }
+        idxc.cache_pages = idxc_size >> idxc_page_shift;
+        if (!(idxc.run_of = vkd3d_malloc(idxc.cache_pages * sizeof(*idxc.run_of))) ||
+                !(idxc.run_owner = vkd3d_calloc(idxc.cache_pages, sizeof(*idxc.run_owner))) ||
+                !(idxc.run_last = vkd3d_calloc(idxc.cache_pages, sizeof(*idxc.run_last))) ||
+                !(idxc.run_gen = vkd3d_calloc(idxc.cache_pages, sizeof(*idxc.run_gen))) ||
+                !(idxc.run_copied = vkd3d_calloc(idxc.cache_pages, sizeof(*idxc.run_copied))))
+        {
+            pthread_mutex_unlock(&idxc_lock);
+            return;
+        }
+        memset(idxc.run_of, 0xff, idxc.cache_pages * sizeof(*idxc.run_of));
+        idxc.cache_ok = true;
+    }
+
+    src_pages = (size_t)((heap->desc.SizeInBytes + (1u << idxc_page_shift) - 1) >> idxc_page_shift);
+    if (!(idxc.table = vkd3d_calloc(src_pages, sizeof(*idxc.table))) ||
+            !(idxc.page_gen = vkd3d_calloc(src_pages, sizeof(*idxc.page_gen))))
+    {
+        pthread_mutex_unlock(&idxc_lock);
+        return;
+    }
+    idxc.heap = heap;
+    idxc.src_buffer = heap->allocation.resource.vk_buffer;
+    idxc.src_offset = heap->allocation.offset;
+    idxc.src_size = heap->desc.SizeInBytes;
+    idxc.src_cpu = heap->allocation.cpu_address;
+    idxc.gen = 1;
+    idxc.cache_head = 0;
+    pthread_mutex_unlock(&idxc_lock);
+
+    INFO("idxcache: source heap %p (%"PRIu64" MiB, memory type %u), cache %"PRIu64" MiB memory type %u, %u byte pages.\n",
+            (void *)heap, (uint64_t)(idxc.src_size >> 20), heap->allocation.device_allocation.vk_memory_type,
+            (uint64_t)(idxc_size >> 20), idxc.cache.device_allocation.vk_memory_type, 1u << idxc_page_shift);
+}
+
+void vkd3d_index_cache_unregister(struct d3d12_heap *heap)
+{
+    pthread_mutex_lock(&idxc_lock);
+    if (idxc.heap == heap)
+    {
+        vkd3d_free(idxc.table);
+        idxc.table = NULL;
+        vkd3d_free(idxc.page_gen);
+        idxc.page_gen = NULL;
+        idxc.src_cpu = NULL;
+        idxc.heap = NULL;
+        idxc.src_buffer = VK_NULL_HANDLE;
+        idxc.pending_count = 0;
+    }
+    pthread_mutex_unlock(&idxc_lock);
+}
+
+bool vkd3d_index_cache_is_source(VkBuffer buffer)
+{
+    return buffer && buffer == idxc.src_buffer;
+}
+
+/* The CPU finished writing [address, address + size) (enginepatch.c, after each geometry write). */
+void vkd3d_index_cache_invalidate_cpu(const void *address, uint64_t size)
+{
+    const uint8_t *p = address;
+    uint32_t first, last, i, g;
+
+    if (!idxc.src_cpu || !size || p < idxc.src_cpu || p >= idxc.src_cpu + idxc.src_size)
+        return;
+    pthread_mutex_lock(&idxc_lock);
+    if (idxc.page_gen && p >= idxc.src_cpu && p < idxc.src_cpu + idxc.src_size)
+    {
+        size = min(size, (uint64_t)(idxc.src_cpu + idxc.src_size - p));
+        first = (uint32_t)((p - idxc.src_cpu) >> idxc_page_shift);
+        last = (uint32_t)((p - idxc.src_cpu + size - 1) >> idxc_page_shift);
+        g = ++idxc.gen;
+        for (i = first; i <= last; i++)
+            idxc.page_gen[i] = g;
+        idxc.invalidations++;
+    }
+    pthread_mutex_unlock(&idxc_lock);
+}
+
+/* Cached copies could go stale behind the cache's back (a GPU write into the source heap, or a
+ * geometry writer the engine hooks don't cover): no cache from here on. */
+void vkd3d_index_cache_disable(const char *why)
+{
+    if (!idxc.disabled)
+    {
+        idxc.disabled = true;
+        ERR("idxcache: %s, turning the index cache off.\n", why);
+    }
+}
+
+/* Find `pages` contiguous cache pages for a new run, evicting runs not drawn recently. Returns the
+ * first page, or -1 when everything in reach is still in use.
+ *
+ * A failed search walks the whole ring (thousands of runs). In heavy scenes the runs drawn in the
+ * last IDXC_REUSE_FRAMES presents fill the ring and ~800 draws a frame fail; walking the ring for
+ * each of them cost tens of ms per frame on the recording thread, with idxc_lock held. Once a
+ * search has failed, larger-or-equal runs are refused for the rest of that present: the set of
+ * evictable pages only shrinks within a present, so the walk would fail again. */
+static int32_t idxc_alloc_locked(uint32_t pages)
+{
+    uint64_t frame = __atomic_load_n(&idxc_frame, __ATOMIC_RELAXED);
+    uint32_t scanned = 0, head, i;
+    int32_t run;
+
+    if (pages > idxc.cache_pages)
+        return -1;
+    if (idxc_failfast && idxc.fail_frame == frame + 1 && pages >= idxc.fail_pages)
+        return -1;
+    while (scanned < 2 * idxc.cache_pages)
+    {
+        idxc.scan_steps++;
+        head = idxc.cache_head;
+        if (head + pages > idxc.cache_pages)
+        {
+            scanned += idxc.cache_pages - head;
+            idxc.cache_head = head = 0;
+        }
+        /* A recently drawn run in the way: step past it and keep looking. */
+        for (i = head; i < head + pages; i++)
+        {
+            if ((run = idxc.run_of[i]) >= 0 && idxc.run_last[run] + IDXC_REUSE_FRAMES > frame)
+                break;
+        }
+        if (i < head + pages)
+        {
+            while (i < idxc.cache_pages && idxc.run_of[i] == run)
+                i++;
+            scanned += i - head;
+            idxc.cache_head = i;
+            continue;
+        }
+        /* Evict every run overlapping [head, head + pages), including ones starting earlier. */
+        for (i = head; i < head + pages; i++)
+        {
+            if ((run = idxc.run_of[i]) < 0)
+                continue;
+            if (idxc.table[idxc.run_owner[run]].slot == (uint32_t)run + 1)
+                idxc.table[idxc.run_owner[run]].slot = 0;
+            while ((uint32_t)run < idxc.cache_pages && idxc.run_of[run] == idxc.run_of[i])
+                idxc.run_of[run++] = -1;
+        }
+        for (i = head; i < head + pages; i++)
+            idxc.run_of[i] = head;
+        idxc.run_last[head] = frame;
+        idxc.cache_head = head + pages;
+        return head;
+    }
+    /* Stored as frame + 1 so that 0 (zero-initialized) never matches present 0. */
+    if (idxc.fail_frame != frame + 1 || pages < idxc.fail_pages)
+    {
+        idxc.fail_frame = frame + 1;
+        idxc.fail_pages = pages;
+    }
+    return -1;
+}
+
+/* The draw reads [offset, offset + size) of `buffer`. On success, bind *out_buffer at *out_offset
+ * with firstIndex 0 instead. */
+bool vkd3d_index_cache_lookup(VkBuffer buffer, VkDeviceSize offset, VkDeviceSize size,
+        VkBuffer *out_buffer, VkDeviceSize *out_offset)
+{
+    VkDeviceSize rel, end, run_start;
+    struct idxc_entry *e;
+    uint32_t p0, pages;
+    struct idxc_copy *c;
+
+    if (!size)
+        return false;
+
+    pthread_mutex_lock(&idxc_lock);
+    if (buffer != idxc.src_buffer || !idxc.table || offset < idxc.src_offset || idxc.disabled)
+    {
+        pthread_mutex_unlock(&idxc_lock);
+        return false;
+    }
+    rel = offset - idxc.src_offset;
+    end = rel + size;
+    if (end > idxc.src_size)
+    {
+        pthread_mutex_unlock(&idxc_lock);
+        return false;
+    }
+    p0 = rel >> idxc_page_shift;
+    pages = ((end - 1) >> idxc_page_shift) - p0 + 1;
+    e = &idxc.table[p0];
+
+    if (e->slot && e->pages >= pages)
+    {
+        uint32_t i, g = idxc.run_gen[e->slot - 1];
+
+        for (i = 0; i < pages; i++)
+        {
+            if (idxc.page_gen[p0 + i] > g)
+                break;
+        }
+        if (i < pages)
+        {
+            e->slot = 0; /* written since it was copied: copy again */
+            idxc.stale++;
+        }
+    }
+    if (e->slot && e->pages >= pages)
+    {
+        idxc.run_last[e->slot - 1] = __atomic_load_n(&idxc_frame, __ATOMIC_RELAXED);
+        idxc.hits++;
+        if (idxc_verify && idxc.cache.cpu_address && !(idxc.hits & 15) &&
+                idxc.run_copied[e->slot - 1] + 4 <= idxc.run_last[e->slot - 1])
+        {
+            const uint8_t *cached = (const uint8_t *)idxc.cache.cpu_address +
+                    ((VkDeviceSize)(e->slot - 1) << idxc_page_shift) + (rel - ((VkDeviceSize)p0 << idxc_page_shift));
+
+            idxc.verified++;
+            if (memcmp(cached, idxc.src_cpu + rel, size))
+            {
+                if (idxc.mismatched++ < 10)
+                    ERR("idxcache verify: %"PRIu64" bytes at heap offset %#"PRIx64" differ from the cached copy "
+                            "(run gen %u, page gen %u).\n", (uint64_t)size, (uint64_t)rel,
+                            idxc.run_gen[e->slot - 1], idxc.page_gen[p0]);
+            }
+        }
+    }
+    else
+    {
+        int32_t first;
+
+        if (pages > UINT16_MAX || !vkd3d_array_reserve((void **)&idxc.pending, &idxc.pending_size,
+                idxc.pending_count + 1, sizeof(*idxc.pending)) || (first = idxc_alloc_locked(pages)) < 0)
+        {
+            idxc.full++;
+            pthread_mutex_unlock(&idxc_lock);
+            return false;
+        }
+        e->pages = pages;
+        e->slot = first + 1;
+        idxc.run_owner[first] = p0;
+        idxc.run_gen[first] = idxc.gen;
+        idxc.run_copied[first] = __atomic_load_n(&idxc_frame, __ATOMIC_RELAXED);
+
+        run_start = (VkDeviceSize)p0 << idxc_page_shift;
+        c = &idxc.pending[idxc.pending_count++];
+        c->src = idxc.src_offset + run_start;
+        c->dst = idxc.cache.offset + ((VkDeviceSize)(e->slot - 1) << idxc_page_shift);
+        c->size = min((VkDeviceSize)pages << idxc_page_shift, idxc.src_size - run_start);
+        idxc.bytes += c->size;
+        idxc.misses++;
+    }
+
+    *out_buffer = idxc.cache.resource.vk_buffer;
+    *out_offset = idxc.cache.offset + ((VkDeviceSize)(e->slot - 1) << idxc_page_shift) +
+            (rel - ((VkDeviceSize)p0 << idxc_page_shift));
+    pthread_mutex_unlock(&idxc_lock);
+    return true;
+}
+
+/* Start of every ExecuteCommandLists, before the memory transfer queue is flushed. */
+void vkd3d_index_cache_flush(struct d3d12_device *device)
+{
+    size_t i;
+
+    if (!idxc.pending_count)
+        return;
+    pthread_mutex_lock(&idxc_lock);
+    for (i = 0; i < idxc.pending_count; i++)
+        vkd3d_memory_transfer_queue_copy_buffer(&device->memory_transfers, idxc.src_buffer, idxc.pending[i].src,
+                idxc.cache.resource.vk_buffer, idxc.pending[i].dst, idxc.pending[i].size, false);
+    idxc.pending_count = 0;
+    pthread_mutex_unlock(&idxc_lock);
+}
+
+bool vkd3d_index_cache_take_stats(uint64_t *hits, uint64_t *misses, uint64_t *full, uint64_t *bytes,
+        uint32_t *used_mib, uint64_t *stale, uint64_t *invalidations, uint64_t *verified, uint64_t *mismatched,
+        uint64_t *scan_steps)
+{
+    if (!idxc.cache_ok)
+        return false;
+    pthread_mutex_lock(&idxc_lock);
+    *hits = idxc.hits;
+    *misses = idxc.misses;
+    *full = idxc.full;
+    *bytes = idxc.bytes;
+    *used_mib = (uint32_t)(((uint64_t)idxc.cache_head << idxc_page_shift) >> 20); /* ring position */
+    *stale = idxc.stale;
+    *invalidations = idxc.invalidations;
+    *verified = idxc.verified;
+    *mismatched = idxc.mismatched;
+    *scan_steps = idxc.scan_steps;
+    idxc.scan_steps = 0;
+    idxc.verified = 0; /* mismatched stays cumulative */
+    idxc.hits = idxc.misses = idxc.full = idxc.bytes = idxc.stale = idxc.invalidations = 0;
+    pthread_mutex_unlock(&idxc_lock);
+    return true;
+}
diff --git a/libs/vkd3d/lightgrid.c b/libs/vkd3d/lightgrid.c
new file mode 100644
index 00000000..8d350b6e
--- /dev/null
+++ b/libs/vkd3d/lightgrid.c
@@ -0,0 +1,470 @@
+/*
+ * Lazy light grid (miles-bench, VKD3D_BENCH_LIGHTGRID_SPARSE=1).
+ *
+ * LightGridManager::Init (0x1c2d800) creates the "Light Grid Data Buffer" as a placed buffer at
+ * offset 0 of a heap of its own: n = min(requested, 0x1fff) pages of 64 KiB, 512 MiB of VRAM. The
+ * engine hands out pages 0..n-2 from a 3-level bitmap allocator (struct at 0x6a453a8, initialised
+ * by 0x2164100 before the buffer is created; bit p of the last level, MSB first, is page p,
+ * set = allocated; freed by 0x2163f20). Allocation is first fit: in the bench scene 1732 pages were
+ * in use and the highest was page 1731. Page n-1 is the "null page": every "Light Grid Lookup"
+ * entry starts out pointing at it, and the GPU only ever reaches other pages through lookup
+ * entries the CPU writes after allocating them.
+ *
+ * Here that heap gets no memory of its own and the buffer is created as a sparse (reserved) buffer.
+ * The null page and pages 0..bound-1 are backed by VRAM: bound starts at
+ * VKD3D_BENCH_LIGHTGRID_INITIAL pages (default 5120) and grows in 4 MiB steps to stay
+ * VKD3D_BENCH_LIGHTGRID_MARGIN pages (default 512) ahead of the highest allocated page. Every
+ * ExecuteCommandLists first checks the bitmap and, if more pages are needed, backs them and waits
+ * for the bind on the CPU before anything is submitted, on any queue. A list can only use a page
+ * after the CPU allocated it, so every page a list can address is backed when the list reaches the
+ * GPU.
+ *
+ * Growth needs free VRAM at a time the game's texture streamer has usually filled it, so the
+ * budget the game reads (IDXGIAdapter3::QueryVideoMemoryInfo, local segment) is lowered by twice
+ * the margin plus any shortfall: the streamer keeps that much VRAM free (it places textures it
+ * cannot fit in system memory, same textures, sampled from there). In the open world the game goes
+ * over that budget anyway (usage ~2480 MiB against ~2250, play-1013/1014) and growth then finds
+ * no VRAM; the pages it could not back were read as zeros, lights missing (a visibly dark area in
+ * the chase, user report 2026-10-14). Hence the larger initial backing. Growth would fall back to
+ * system memory if the buffer allowed it, but on this GPU sparse buffers only take the VRAM type
+ * (memory types 0x80). A failed growth is retried every 20 ms; a page in use that is not backed is
+ * a loss and is counted and logged as one.
+ *
+ * Contents are those of the original: the original heap is a fresh, driver-zeroed allocation, the
+ * backing chunks are fresh driver-zeroed allocations too (NVIDIA zeroes new device memory; vkd3d's
+ * allocator relies on the same, vkd3d_driver_can_zero_clear_alloc), and backed pages stay backed
+ * for the life of the buffer, so a page that is freed and handed out again keeps its old contents
+ * exactly as before. Pages that are never backed were never allocated, so nothing writes them and
+ * nothing reads them; with residencyNonResidentStrict a stray read would see zeros, which is what
+ * the original's never-written pages hold.
+ */
+
+#define VKD3D_DBG_CHANNEL VKD3D_DBG_CHANNEL_API
+
+#include "vkd3d_private.h"
+
+#define LIGHTGRID_PAGE 0x10000u
+#define LIGHTGRID_CHUNK_PAGES 64u
+#define LIGHTGRID_RETRY_NS 20000000ull
+#define LIGHTGRID_BITMAP_RVA 0x6a453a8u
+#define LIGHTGRID_EXE_TIMESTAMP 0x6374c7f4u /* MilesMorales.exe v1.1116.0.0 */
+
+/* The engine's bitmap allocator (0x2164100). */
+struct lightgrid_bitmap
+{
+    uint64_t *level0;
+    uint64_t *level1;
+    uint64_t *level2;
+    int32_t count;
+    int32_t used;
+    int32_t highest;
+};
+
+static int lightgrid_enabled = -1;
+/* Initial backing: in the open world the engine reaches page ~4340 (the Rhino chase, fr1) while the
+ * game itself runs over its VRAM budget, so growth can find no VRAM there and the sparse buffer
+ * only takes VRAM-only memory types (0x80 on this GPU, no system memory fallback). 5120 pages
+ * (320 MiB of 512) are backed at creation, when VRAM is still free; growth covers the rest. */
+static uint32_t lightgrid_margin = 512, lightgrid_initial = 5120;
+static pthread_mutex_t lightgrid_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static struct
+{
+    const struct lightgrid_bitmap *bitmap;
+    struct d3d12_device *device;
+    struct d3d12_resource *resource;
+    uint32_t pages;           /* n: buffer pages, the null page included */
+    uint32_t bound;           /* pages 0..bound-1 are backed */
+    uint32_t wanted;          /* pages the last growth aimed for */
+    uint32_t memory_type;
+    uint32_t type_bits;       /* the buffer's memory types (system memory fallback) */
+    uint32_t fallback_type;   /* the system memory type last used for growth; memoryTypeCount: none yet */
+    VkDeviceMemory *chunks;
+    size_t chunk_count, chunk_size;
+    VkDeviceMemory null_page;
+    VkFence fence;
+    bool broken;              /* setup failed: nothing is backed beyond what is */
+    bool in_loss;             /* an allocated page is not backed (frametrace E lines mark changes) */
+    uint64_t retry_at;
+    uint32_t highest_seen;
+    uint64_t grows, grow_ns, failed_allocs, unbacked_checks;
+    uint32_t sysmem_pages;
+} lightgrid;
+
+static bool lightgrid_wanted(void)
+{
+    char env[16];
+
+    if (lightgrid_enabled < 0)
+    {
+        lightgrid_enabled = vkd3d_get_env_var("VKD3D_BENCH_LIGHTGRID_SPARSE", env, sizeof(env)) && atoi(env) == 1;
+        if (vkd3d_get_env_var("VKD3D_BENCH_LIGHTGRID_MARGIN", env, sizeof(env)) && atoi(env) > 0)
+            lightgrid_margin = atoi(env);
+        if (vkd3d_get_env_var("VKD3D_BENCH_LIGHTGRID_INITIAL", env, sizeof(env)) && atoi(env) > 0)
+            lightgrid_initial = atoi(env);
+    }
+    return lightgrid_enabled;
+}
+
+static const struct lightgrid_bitmap *lightgrid_engine_bitmap(void)
+{
+    const IMAGE_NT_HEADERS64 *nt;
+    const IMAGE_DOS_HEADER *dos;
+    const uint8_t *image;
+
+    if (!(image = (const uint8_t *)GetModuleHandleW(NULL)))
+        return NULL;
+    dos = (const IMAGE_DOS_HEADER *)image;
+    nt = (const IMAGE_NT_HEADERS64 *)(image + dos->e_lfanew);
+    if (nt->FileHeader.TimeDateStamp != LIGHTGRID_EXE_TIMESTAMP)
+        return NULL;
+    return (const struct lightgrid_bitmap *)(image + LIGHTGRID_BITMAP_RVA);
+}
+
+/* The light grid heap: DEFAULT, buffers only, exactly (bitmap pages + 1) x 64 KiB, created right
+ * after the engine set up the bitmap for that many pages. */
+bool vkd3d_lightgrid_heap_wanted(const D3D12_HEAP_DESC *desc)
+{
+    const struct lightgrid_bitmap *bitmap;
+
+    if (!lightgrid_wanted() || lightgrid.resource)
+        return false;
+    if (desc->Properties.Type != D3D12_HEAP_TYPE_DEFAULT ||
+            (desc->Flags & (D3D12_HEAP_FLAG_DENY_RT_DS_TEXTURES | D3D12_HEAP_FLAG_DENY_NON_RT_DS_TEXTURES)) !=
+            (D3D12_HEAP_FLAG_DENY_RT_DS_TEXTURES | D3D12_HEAP_FLAG_DENY_NON_RT_DS_TEXTURES))
+        return false;
+    if (!(bitmap = lightgrid_engine_bitmap()) || !bitmap->level2 || bitmap->count < 64 ||
+            desc->SizeInBytes != (uint64_t)(bitmap->count + 1) * LIGHTGRID_PAGE)
+        return false;
+    INFO("light grid: heap of %u pages matches the engine's page bitmap; it gets no memory, "
+            "its buffer is backed page by page.\n", bitmap->count + 1);
+    return true;
+}
+
+static int32_t lightgrid_highest(void)
+{
+    const uint64_t *words = lightgrid.bitmap->level2;
+    int32_t w;
+    uint64_t v;
+
+    for (w = (int32_t)((lightgrid.pages - 2) >> 6); w >= 0; w--)
+    {
+        if ((v = vkd3d_atomic_uint64_load_explicit((uint64_t *)&words[w], vkd3d_memory_order_relaxed)))
+            return w * 64 + 63 - __builtin_ctzll(v); /* MSB first: the lowest set bit is the highest page */
+    }
+    return -1;
+}
+
+static bool lightgrid_bind(VkDeviceSize offset, VkDeviceSize size, VkDeviceMemory memory)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &lightgrid.device->vk_procs;
+    struct d3d12_device *device = lightgrid.device;
+    VkSparseBufferMemoryBindInfo buffer_info;
+    VkBindSparseInfo bind_info;
+    VkSparseMemoryBind bind;
+    VkQueue vk_queue;
+    VkResult vr;
+
+    memset(&bind, 0, sizeof(bind));
+    bind.resourceOffset = offset;
+    bind.size = size;
+    bind.memory = memory;
+    buffer_info.buffer = lightgrid.resource->res.vk_buffer;
+    buffer_info.bindCount = 1;
+    buffer_info.pBinds = &bind;
+    memset(&bind_info, 0, sizeof(bind_info));
+    bind_info.sType = VK_STRUCTURE_TYPE_BIND_SPARSE_INFO;
+    bind_info.bufferBindCount = 1;
+    bind_info.pBufferBinds = &buffer_info;
+
+    if (!(vk_queue = vkd3d_queue_acquire(device->internal_sparse_queue)))
+        return false;
+    vr = VK_CALL(vkQueueBindSparse(vk_queue, 1, &bind_info, lightgrid.fence));
+    vkd3d_queue_release(device->internal_sparse_queue);
+    if (vr >= 0)
+        vr = VK_CALL(vkWaitForFences(device->vk_device, 1, &lightgrid.fence, VK_TRUE, UINT64_MAX));
+    VK_CALL(vkResetFences(device->vk_device, 1, &lightgrid.fence));
+    if (vr < 0)
+        ERR("light grid: sparse bind of %#"PRIx64"+%#"PRIx64" failed, vr %d.\n", offset, size, vr);
+    return vr >= 0;
+}
+
+static VkDeviceMemory lightgrid_alloc(VkDeviceSize size, uint32_t type)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &lightgrid.device->vk_procs;
+    VkMemoryAllocateInfo info;
+    VkDeviceMemory memory;
+
+    memset(&info, 0, sizeof(info));
+    info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+    info.allocationSize = size;
+    info.memoryTypeIndex = type;
+    if (VK_CALL(vkAllocateMemory(lightgrid.device->vk_device, &info, NULL, &memory)) < 0)
+        return VK_NULL_HANDLE;
+    return memory;
+}
+
+/* Back pages up to (not including) target. Called with lightgrid_lock held. */
+static void lightgrid_grow(uint32_t target)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &lightgrid.device->vk_procs;
+    uint64_t t0 = vkd3d_get_current_time_ns();
+    uint32_t count, bound0 = lightgrid.bound, sysmem0 = lightgrid.sysmem_pages;
+    VkDeviceMemory memory;
+    bool failed = false;
+
+    lightgrid.wanted = max(lightgrid.wanted, target);
+    while (lightgrid.bound < target)
+    {
+        count = min(LIGHTGRID_CHUNK_PAGES, lightgrid.pages - 1 - lightgrid.bound);
+        if (!vkd3d_array_reserve((void **)&lightgrid.chunks, &lightgrid.chunk_size,
+                lightgrid.chunk_count + 1, sizeof(*lightgrid.chunks)))
+            memory = VK_NULL_HANDLE;
+        else if (!(memory = lightgrid_alloc((VkDeviceSize)count * LIGHTGRID_PAGE, lightgrid.memory_type)) &&
+                (lightgrid.fallback_type = vkd3d_bench_sysmem_alloc(lightgrid.device, lightgrid.type_bits,
+                (VkDeviceSize)count * LIGHTGRID_PAGE, &memory)) < lightgrid.device->memory_properties.memoryTypeCount)
+        {
+            if (!lightgrid.sysmem_pages)
+                ERR("light grid: VRAM is full; backing pages from %u on with system memory (type %u).\n",
+                        lightgrid.bound, lightgrid.fallback_type);
+            lightgrid.sysmem_pages += count;
+        }
+        if (!memory)
+        {
+            if (!(lightgrid.failed_allocs++ % 50))
+                ERR("light grid: no VRAM for pages %u-%u yet (%"PRIu64" failed attempts); retrying.\n",
+                        lightgrid.bound, target - 1, lightgrid.failed_allocs);
+            lightgrid.retry_at = t0 + LIGHTGRID_RETRY_NS;
+            failed = true;
+            break;
+        }
+        if (!lightgrid_bind((VkDeviceSize)lightgrid.bound * LIGHTGRID_PAGE, (VkDeviceSize)count * LIGHTGRID_PAGE, memory))
+        {
+            VK_CALL(vkFreeMemory(lightgrid.device->vk_device, memory, NULL));
+            lightgrid.retry_at = t0 + LIGHTGRID_RETRY_NS;
+            failed = true;
+            break;
+        }
+        lightgrid.chunks[lightgrid.chunk_count++] = memory;
+        lightgrid.bound += count;
+    }
+    lightgrid.grows++;
+    lightgrid.grow_ns += vkd3d_get_current_time_ns() - t0;
+    vkd3d_frametrace_event("lightgrid grow %s %.3f ms pages %u -> %u, target %u, highest %u, system memory +%u pages",
+            failed ? "fail" : "ok", (vkd3d_get_current_time_ns() - t0) / 1e6, bound0, lightgrid.bound, target,
+            lightgrid.highest_seen, lightgrid.sysmem_pages - sysmem0);
+    INFO("light grid: %u of %u pages backed (%u MiB, %u pages in system memory), highest allocated page %u, "
+            "%.2f ms in %"PRIu64" grows.\n", lightgrid.bound + 1, lightgrid.pages, (lightgrid.bound + 1) >> 4,
+            lightgrid.sysmem_pages, lightgrid.highest_seen, lightgrid.grow_ns / 1e6, lightgrid.grows);
+}
+
+static uint32_t lightgrid_target(int32_t highest)
+{
+    return min((uint32_t)(highest + 1) + lightgrid_margin, lightgrid.pages - 1);
+}
+
+HRESULT vkd3d_lightgrid_create_placed(struct d3d12_device *device, struct d3d12_heap *heap,
+        uint64_t heap_offset, const D3D12_RESOURCE_DESC1 *desc, D3D12_RESOURCE_STATES initial_state,
+        struct d3d12_resource **resource)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &device->vk_procs;
+    VkMemoryRequirements requirements;
+    struct d3d12_resource *object;
+    VkFenceCreateInfo fence_info;
+    uint32_t pages, type_bits;
+    HRESULT hr;
+
+    pages = heap->desc.SizeInBytes / LIGHTGRID_PAGE;
+    if (desc->Dimension != D3D12_RESOURCE_DIMENSION_BUFFER || heap_offset || desc->Width != heap->desc.SizeInBytes ||
+            !device->internal_sparse_queue)
+    {
+        ERR("light grid: unexpected placement (dimension %u, offset %#"PRIx64", width %#"PRIx64") in the "
+                "memoryless heap.\n", desc->Dimension, heap_offset, desc->Width);
+        return E_INVALIDARG;
+    }
+
+    if (FAILED(hr = d3d12_resource_create_reserved(device, desc, initial_state, NULL, 0, NULL, &object)))
+        return hr;
+    if (!(object->flags & VKD3D_RESOURCE_RESERVED))
+    {
+        ERR("light grid: reserved buffer fell back to a committed one.\n");
+        *resource = object;
+        return S_OK;
+    }
+    d3d12_resource_wait_for_sparse_init(object);
+
+    /* Plain VRAM, like the DEFAULT heap it replaces (not the host-visible BAR window). */
+    VK_CALL(vkGetBufferMemoryRequirements(device->vk_device, object->res.vk_buffer, &requirements));
+    type_bits = requirements.memoryTypeBits;
+    for (lightgrid.memory_type = 0; lightgrid.memory_type < device->memory_properties.memoryTypeCount; lightgrid.memory_type++)
+    {
+        VkMemoryPropertyFlags flags = device->memory_properties.memoryTypes[lightgrid.memory_type].propertyFlags;
+
+        if ((type_bits & (1u << lightgrid.memory_type)) && (flags & VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT) &&
+                !(flags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
+            break;
+    }
+    lightgrid.type_bits = type_bits;
+    lightgrid.fallback_type = device->memory_properties.memoryTypeCount;
+
+    memset(&fence_info, 0, sizeof(fence_info));
+    fence_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+
+    pthread_mutex_lock(&lightgrid_lock);
+    lightgrid.bitmap = lightgrid_engine_bitmap();
+    lightgrid.device = device;
+    lightgrid.resource = object;
+    lightgrid.pages = pages;
+    lightgrid.bound = 0;
+    if (lightgrid.memory_type == device->memory_properties.memoryTypeCount ||
+            VK_CALL(vkCreateFence(device->vk_device, &fence_info, NULL, &lightgrid.fence)) < 0 ||
+            !(lightgrid.null_page = lightgrid_alloc(LIGHTGRID_PAGE, lightgrid.memory_type)) ||
+            !lightgrid_bind((VkDeviceSize)(pages - 1) * LIGHTGRID_PAGE, LIGHTGRID_PAGE, lightgrid.null_page))
+    {
+        ERR("light grid: setup failed (memory types %#x); the buffer stays unbacked.\n", type_bits);
+        lightgrid.broken = true;
+    }
+    else
+    {
+        lightgrid.highest_seen = max(lightgrid_highest(), 0);
+        lightgrid_grow(max(min(lightgrid_initial, pages - 1), lightgrid_target(lightgrid_highest())));
+    }
+    pthread_mutex_unlock(&lightgrid_lock);
+
+    INFO("light grid: \"Light Grid Data Buffer\" is sparse: %u pages, VA %#"PRIx64", memory type %u (types %#x), "
+            "initial %u, margin %u pages.\n", pages, object->res.va, lightgrid.memory_type,
+            lightgrid.type_bits, lightgrid_initial, lightgrid_margin);
+    *resource = object;
+    return S_OK;
+}
+
+void vkd3d_lightgrid_update(void)
+{
+    uint32_t bound, target;
+    int32_t highest;
+    uint64_t now;
+
+    if (!lightgrid.resource || lightgrid.broken)
+        return;
+    highest = lightgrid_highest();
+    bound = vkd3d_atomic_uint32_load_explicit(&lightgrid.bound, vkd3d_memory_order_acquire);
+    if ((uint32_t)(highest + 1) + lightgrid_margin / 2 <= bound)
+        return;
+
+    pthread_mutex_lock(&lightgrid_lock);
+    if (lightgrid.resource)
+    {
+        highest = lightgrid_highest();
+        lightgrid.highest_seen = max(lightgrid.highest_seen, (uint32_t)max(highest, 0));
+        target = lightgrid_target(highest);
+        now = vkd3d_get_current_time_ns();
+        if (target > lightgrid.bound && (now >= lightgrid.retry_at || highest >= (int32_t)lightgrid.bound))
+            lightgrid_grow(target);
+        if ((highest >= (int32_t)lightgrid.bound) != lightgrid.in_loss)
+        {
+            lightgrid.in_loss = !lightgrid.in_loss;
+            vkd3d_frametrace_event("lightgrid loss %s page %d bound %u", lightgrid.in_loss ? "start" : "end",
+                    highest, lightgrid.bound);
+        }
+        if (highest >= (int32_t)lightgrid.bound && !(lightgrid.unbacked_checks++ % 100))
+            ERR("light grid: LOSS: page %d is in use but only %u pages are backed (%"PRIu64" submissions so far).\n",
+                    highest, lightgrid.bound, lightgrid.unbacked_checks);
+    }
+    pthread_mutex_unlock(&lightgrid_lock);
+}
+
+/* VRAM the game should leave free: room for two margins of growth, plus any pages still wanted. */
+uint64_t vkd3d_lightgrid_budget_reserve(void)
+{
+    uint32_t wanted, bound;
+
+    if (!lightgrid.resource || lightgrid.broken)
+        return 0;
+    wanted = vkd3d_atomic_uint32_load_explicit(&lightgrid.wanted, vkd3d_memory_order_relaxed);
+    bound = vkd3d_atomic_uint32_load_explicit(&lightgrid.bound, vkd3d_memory_order_relaxed);
+    return ((uint64_t)2 * lightgrid_margin + (wanted > bound ? wanted - bound : 0)) * LIGHTGRID_PAGE;
+}
+
+/* Called from d3d12_resource_destroy once the buffer's Vulkan objects are gone, which is when
+ * vkd3d frees a placed resource's memory too. */
+void vkd3d_lightgrid_resource_destroyed(struct d3d12_resource *resource)
+{
+    const struct vkd3d_vk_device_procs *vk_procs;
+    size_t i;
+
+    if (!resource || resource != lightgrid.resource)
+        return;
+    pthread_mutex_lock(&lightgrid_lock);
+    vk_procs = &lightgrid.device->vk_procs;
+    INFO("light grid: buffer destroyed; %u of %u pages were backed (%u in system memory), highest allocated page %u, "
+            "%"PRIu64" failed allocations, %"PRIu64" submissions with an unbacked page in use.\n",
+            lightgrid.bound + 1, lightgrid.pages, lightgrid.sysmem_pages, lightgrid.highest_seen,
+            lightgrid.failed_allocs, lightgrid.unbacked_checks);
+    for (i = 0; i < lightgrid.chunk_count; i++)
+        VK_CALL(vkFreeMemory(lightgrid.device->vk_device, lightgrid.chunks[i], NULL));
+    if (lightgrid.null_page)
+        VK_CALL(vkFreeMemory(lightgrid.device->vk_device, lightgrid.null_page, NULL));
+    if (lightgrid.fence)
+        VK_CALL(vkDestroyFence(lightgrid.device->vk_device, lightgrid.fence, NULL));
+    vkd3d_free(lightgrid.chunks);
+    memset(&lightgrid, 0, sizeof(lightgrid));
+    pthread_mutex_unlock(&lightgrid_lock);
+}
+
+/* The budget the game sees. DXVK's adapter implements IDXGIAdapter4 in one chain, so
+ * QueryVideoMemoryInfo is vtable slot 14 (IUnknown 3, IDXGIObject 4, IDXGIAdapter 3, 1 and 2 one
+ * each, then IDXGIAdapter3's RegisterHardwareContentProtectionTeardownStatusEvent and
+ * UnregisterHardwareContentProtectionTeardownStatus). The vtable is shared by every adapter object
+ * of that class, the game's included. */
+struct lightgrid_video_memory_info
+{
+    uint64_t budget, current_usage, available_for_reservation, current_reservation;
+};
+
+typedef HRESULT (STDMETHODCALLTYPE *lightgrid_query_video_memory_info)(IUnknown *iface, UINT node,
+        UINT segment_group, struct lightgrid_video_memory_info *info);
+static lightgrid_query_video_memory_info lightgrid_query_original;
+static uint64_t lightgrid_budget_queries;
+
+static HRESULT STDMETHODCALLTYPE lightgrid_query_video_memory_info_hook(IUnknown *iface, UINT node,
+        UINT segment_group, struct lightgrid_video_memory_info *info)
+{
+    uint64_t reserve;
+    HRESULT hr;
+
+    hr = lightgrid_query_original(iface, node, segment_group, info);
+    if (SUCCEEDED(hr) && info && segment_group == 0 /* DXGI_MEMORY_SEGMENT_GROUP_LOCAL */ &&
+            (reserve = vkd3d_lightgrid_budget_reserve() + vkd3d_skinbuf_budget_reserve()))
+    {
+        info->budget = info->budget > reserve ? info->budget - reserve : 0;
+        if (!(lightgrid_budget_queries++ % 3600))
+            INFO("light grid: VRAM budget reported %"PRIu64" MiB (%"PRIu64" MiB held for light grid and skinning growth), "
+                    "usage %"PRIu64" MiB.\n", info->budget >> 20, reserve >> 20, info->current_usage >> 20);
+    }
+    return hr;
+}
+
+void vkd3d_lightgrid_hook_budget(IUnknown *adapter)
+{
+    static const GUID iid_adapter3 = {0x645967a4, 0x1392, 0x4310, {0xa7, 0x98, 0x80, 0x53, 0xce, 0x3e, 0x93, 0xfd}};
+    IUnknown *adapter3;
+    DWORD old_protect;
+    void **vtbl;
+
+    if ((!lightgrid_wanted() && !vkd3d_skinbuf_wanted()) || lightgrid_query_original || !adapter)
+        return;
+    if (FAILED(IUnknown_QueryInterface(adapter, &iid_adapter3, (void **)&adapter3)))
+    {
+        ERR("light grid: adapter has no IDXGIAdapter3; the VRAM budget is not adjusted.\n");
+        return;
+    }
+    vtbl = *(void ***)adapter3;
+    if (VirtualProtect(&vtbl[14], sizeof(void *), PAGE_READWRITE, &old_protect))
+    {
+        lightgrid_query_original = (lightgrid_query_video_memory_info)vtbl[14];
+        vtbl[14] = (void *)lightgrid_query_video_memory_info_hook;
+        VirtualProtect(&vtbl[14], sizeof(void *), old_protect, &old_protect);
+        INFO("light grid: hooked QueryVideoMemoryInfo (vtable %p).\n", vtbl);
+    }
+    IUnknown_Release(adapter3);
+}
