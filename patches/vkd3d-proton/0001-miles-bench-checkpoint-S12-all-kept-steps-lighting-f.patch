+static struct vkd3d_particle_scratch
+{
+    VkDeviceAddress va;
+    uint32_t range;
+    struct d3d12_resource *copies[VKD3D_PARTICLE_MAX_COPIES]; /* [0] unused: system 0 keeps the original */
