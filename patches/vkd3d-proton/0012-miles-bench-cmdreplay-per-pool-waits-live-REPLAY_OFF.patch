+static void rp_pool_wait(struct rp_pool *pool)
+{
+    uint64_t seq = __atomic_load_n(&pool->last_seq, __ATOMIC_ACQUIRE);
+
+    if (pool->secondaries)
+        seq = max(seq, __atomic_load_n(&rp.exec_seq, __ATOMIC_ACQUIRE));
+    rp_wait(seq, &rp.pool_waits);
+}
