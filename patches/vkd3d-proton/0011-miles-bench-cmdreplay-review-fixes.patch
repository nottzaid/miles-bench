diff --git a/libs/vkd3d/cmdreplay_gen.py b/libs/vkd3d/cmdreplay_gen.py
index b843a0d9..7b5544ff 100644
--- a/libs/vkd3d/cmdreplay_gen.py
+++ b/libs/vkd3d/cmdreplay_gen.py
@@ -40,8 +40,10 @@ for ret, name, params in re.findall(r"VKAPI_ATTR (\w+) VKAPI_CALL (vk\w+)\(\s*(.
 # Types through which a command buffer handle can reach a function.
 CB_TYPES = ("VkCommandBuffer", "VkSubmitInfo", "VkSubmitInfo2", "VkCommandBufferSubmitInfo",
             "VkDebugUtilsObjectNameInfoEXT", "VkDebugUtilsObjectTagInfoEXT")
+# vkFreeMemory is left alone: memory is freed only once the GPU is done with it, so every op naming
+# it was replayed before its submission, and holding it back would keep VRAM from the next allocation.
 GUARDED = lambda n: (n.startswith(("vkDestroy", "vkFree")) or n == "vkResetDescriptorPool") and n not in (
-    "vkDestroyDevice", "vkDestroyCommandPool", "vkFreeCommandBuffers")
+    "vkDestroyDevice", "vkDestroyCommandPool", "vkFreeCommandBuffers", "vkFreeMemory")
 
 
 # Destroys of the form (device, handle, pAllocator) are queued behind the published ops instead of
@@ -65,6 +67,8 @@ out = ["/* Generated by cmdreplay_gen.py from vulkan_core.h and vulkan_procs.h;
 installs, drains, missing = [], [], []
 for name in device_fns:
     if name not in protos:
+        if name.startswith("vkCmd") or name in hand:
+            missing.append(name + " (no prototype in vulkan_core.h)")
         continue
     ret, plist = protos[name]
     sees_cb = any(any(re.search(rf"\b{t}\b", p[0]) for t in CB_TYPES) for p in plist)
@@ -119,8 +123,8 @@ for name in device_fns:
     elif GUARDED(name):
         args = ", ".join(n for _, n, _ in plist)
         out.append(f"static VKAPI_ATTR {ret} VKAPI_CALL rp_{name}({decl(plist)})\n{{\n"
-                   f"    rp_guard();\n"
-                   f"    {'return ' if ret != 'void' else ''}rp_real.{name}({args});\n}}\n")
+                   + (f"    if ({plist[1][1]})\n        rp_guard();\n" if by_value(plist[1][0], plist[1][2]) else "    rp_guard();\n")
+                   + f"    {'return ' if ret != 'void' else ''}rp_real.{name}({args});\n}}\n")
         installs.append(name)
 
 if missing:
