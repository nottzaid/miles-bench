# The frozen S14 checkpoint: its own DLLs (build/checkpoint-s14/bin) and a read-only copy of the sizes it
# had learned (build/checkpoint-s14/learned), with s13-learned.env, for A/B against newer builds. Its
# sessions still learn in memory but never write the copy, so every run starts from the same values.
BENCH_DLLS=/home/zaid/Projects/miles-bench/build/checkpoint-s14/bin
VKD3D_BENCH_LEARNED_PATH=/home/zaid/Projects/miles-bench/build/checkpoint-s14/learned
VKD3D_BENCH_VRAM_RESERVE=1
VKD3D_ENGINE_PATCH=gdec,dropdst
VKD3D_BENCH_INDEX_CACHE=1
VKD3D_BENCH_PARTICLE_BATCH=16
VKD3D_BENCH_DISCARD_KEEP=1
VKD3D_BENCH_PDRAW=1
VKD3D_BENCH_LAZY_HEAPS=1
VKD3D_BENCH_LIGHTGRID_SPARSE=1
VKD3D_BENCH_SKIN_SPARSE=1
