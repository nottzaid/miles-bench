# The frozen S12 checkpoint: its own DLLs (build/checkpoint-s12/bin) with s12-current.env, for A/B against newer builds.
BENCH_DLLS=/home/zaid/Projects/miles-bench/build/checkpoint-s12/bin
VKD3D_BENCH_VRAM_RESERVE_MB=192
VKD3D_ENGINE_PATCH=gdec,dropdst
VKD3D_BENCH_INDEX_CACHE=1
VKD3D_BENCH_PARTICLE_BATCH=16
VKD3D_BENCH_DISCARD_KEEP=1
VKD3D_BENCH_PDRAW=1
VKD3D_BENCH_LAZY_HEAPS=1
VKD3D_BENCH_LIGHTGRID_SPARSE=1
VKD3D_BENCH_SKIN_SPARSE=1
