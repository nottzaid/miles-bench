# The frozen S15 checkpoint: its own DLLs (build/checkpoint-s15/bin) and a read-only copy of the learned
# sizes (build/checkpoint-s15/learned, the same values as checkpoint-s13/s14's), for A/B against newer
# builds. Its sessions still learn in memory but never write the copy (a write attempt only logs "cannot
# write"), so every run starts from the same values.
BENCH_DLLS=/home/zaid/Projects/miles-bench/build/checkpoint-s15/bin
VKD3D_BENCH_LEARNED_PATH=/home/zaid/Projects/miles-bench/build/checkpoint-s15/learned
VKD3D_BENCH_VRAM_RESERVE=1
VKD3D_ENGINE_PATCH=gdec,dropdst
VKD3D_BENCH_INDEX_CACHE=1
VKD3D_BENCH_PARTICLE_BATCH=16
VKD3D_BENCH_DISCARD_KEEP=1
VKD3D_BENCH_PDRAW=1
VKD3D_BENCH_LAZY_HEAPS=1
VKD3D_BENCH_LIGHTGRID_SPARSE=1
VKD3D_BENCH_SKIN_SPARSE=1
VKD3D_BENCH_CLEAR_KEEP=1
