# S13 (2026-10-15): S12 with sizes measured instead of fixed. VRAM reserve learned (VKD3D_BENCH_VRAM_RESERVE=1),
# light grid and skinning backed from learned peaks (learned/), gates for other machines. Build: build/memtrace.
VKD3D_BENCH_VRAM_RESERVE=1
VKD3D_ENGINE_PATCH=gdec,dropdst
VKD3D_BENCH_INDEX_CACHE=1
VKD3D_BENCH_PARTICLE_BATCH=16
VKD3D_BENCH_DISCARD_KEEP=1
VKD3D_BENCH_PDRAW=1
VKD3D_BENCH_LAZY_HEAPS=1
VKD3D_BENCH_LIGHTGRID_SPARSE=1
VKD3D_BENCH_SKIN_SPARSE=1
