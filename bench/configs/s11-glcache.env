VKD3D_BENCH_VRAM_RESERVE_MB=192
VKD3D_ENGINE_PATCH=gdec,dropdst
VKD3D_BENCH_INDEX_CACHE=1
VKD3D_BENCH_PARTICLE_BATCH=16
VKD3D_BENCH_DISCARD_KEEP=1
VKD3D_BENCH_PDRAW=1
VKD3D_BENCH_LAZY_HEAPS=1
VKD3D_BENCH_LIGHTGRID_SPARSE=1
VKD3D_BENCH_SKIN_SPARSE=1
# The NVIDIA shader disk cache for the game is full at ~245 MB and stops storing new pipelines, so they
# are compiled again every launch (psoA/psoB). Room for all of them, and no size cleanup.
__GL_SHADER_DISK_CACHE_SIZE=10737418240
__GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1
